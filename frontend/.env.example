# FastAPI base URL used by the browser application.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Separate AMap Web JS API key (not the backend Web Service API key).
VITE_AMAP_JS_KEY=
# Development only: values with VITE_ are bundled into the browser app.
VITE_AMAP_SECURITY_JS_CODE=
# Production: use your fixed security proxy URL instead of exposing securityJsCode.
# Example: https://your-domain.example/_AMapService
VITE_AMAP_SERVICE_HOST=
