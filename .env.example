# Phase 2 will use an OpenAI-compatible model endpoint.
# Never commit the real key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
MODEL_NAME=qwen-plus

# Walking route API key from openrouteservice.
ORS_API_KEY=

# Transit route and coordinate conversion key from AMap Web Service API.
AMAP_API_KEY=

# Optional. Route only Nominatim place-search requests through this proxy.
PLACE_PROXY_URL=
# Optional. Route route-planning and map-service requests through this proxy.
ROUTE_PROXY_URL=

# Local persistence paths.
ITINERARY_STORAGE_PATH=data/itineraries.jsonl
CHECKPOINT_STORAGE_PATH=data/checkpoints.sqlite
CONVERSATION_STORAGE_PATH=data/conversations.sqlite

# JSON list of browser origins allowed to call FastAPI.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Open-Meteo needs no weather API key.
APP_ENV=development
LOG_LEVEL=INFO
