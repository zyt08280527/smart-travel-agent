# Phase 2 will use an OpenAI-compatible model endpoint.
# Never commit the real key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
MODEL_NAME=qwen-plus

# Place search, driving, walking, transit and coordinate conversion key from AMap Web Service API.
AMAP_API_KEY=
ROUTE_SNAPSHOT_TTL_SECONDS=300

# Optional. Route AMap Web Service requests through this proxy.
ROUTE_PROXY_URL=

# Local persistence paths.
ITINERARY_STORAGE_PATH=data/itineraries.jsonl
CHECKPOINT_STORAGE_PATH=data/checkpoints.sqlite
CONVERSATION_STORAGE_PATH=data/conversations.sqlite
# V2-0 business storage foundation; not yet used by the live save tool.
TRIP_STORAGE_PATH=data/trips.sqlite
MULTI_STOP_STORAGE_PATH=data/multi_stop.sqlite
BUSINESS_TIMEZONE=Asia/Shanghai

# JSON list of browser origins allowed to call FastAPI.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Open-Meteo needs no weather API key.
APP_ENV=development
LOG_LEVEL=INFO
